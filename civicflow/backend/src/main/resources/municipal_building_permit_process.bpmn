<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_MunicipalPermit"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.49.0">

  <!-- ========================================== -->
  <!-- MESSAGES FOR FRONTEND ADMIN & CITIZEN SYNC -->
  <!-- ========================================== -->
  <bpmn:message id="Message_DepartmentApproval" name="Message_DepartmentApproval">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= string(applicationId) + &#34;_&#34; + department" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:message id="Message_CitizenPayment" name="Message_CitizenPayment">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= string(applicationId)" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:message id="Message_BlueprintRevised" name="Message_BlueprintRevised">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= string(applicationId)" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:message id="Message_DocumentsCorrected" name="Message_DocumentsCorrected">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= string(applicationId)" />
    </bpmn:extensionElements>
  </bpmn:message>

  <!-- ========================================== -->
  <!-- MAIN BUILDING PERMIT PROCESS DEFINITION   -->
  <!-- ========================================== -->
  <bpmn:process id="Process_MunicipalBuildingPermit" name="Municipal Building Permit Approval Process" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ApplicationSubmitted" name="Application Submitted">
      <bpmn:documentation>Citizen or Architect initiates permit submission from CivicFlow Web Portal.</bpmn:documentation>
      <bpmn:outgoing>Flow_To_DocVerification</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Stage 1: Automated Document Verification Service Task -->
    <bpmn:serviceTask id="Task_DocumentVerification" name="Document Verification">
      <bpmn:documentation>Automated integrity check verifying title deed, architectural plan, and structural certificate uploads.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="document-verification-worker" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_DocVerification</bpmn:incoming>
      <bpmn:incoming>Flow_From_DocCorrection</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Gateway_DocValid</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Document Validity Check -->
    <bpmn:exclusiveGateway id="Gateway_DocVerification" name="Documents Valid?">
      <bpmn:incoming>Flow_To_Gateway_DocValid</bpmn:incoming>
      <bpmn:outgoing>Flow_DocValid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocValid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Receive Task: Missing Document Correction from Frontend -->
    <bpmn:receiveTask id="Task_CorrectMissingDocuments" name="Applicant Corrects Missing Documents" messageRef="Message_DocumentsCorrected">
      <bpmn:documentation>Waits for applicant to upload missing documentation in CivicFlow portal.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="= string(applicationId)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocValid_No</bpmn:incoming>
      <bpmn:outgoing>Flow_From_DocCorrection</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Stage 2: GIS Land Registry REST API Connector -->
    <bpmn:serviceTask id="Task_LandRegistryVerification" name="Verify Land Registry (REST API)" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>REST Outbound Connector: GET to Land Registry GIS API to verify survey number and ownership status.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="= &#34;http://localhost:8081/api/land-registry/verify/&#34; + (if surveyNumber != null and surveyNumber != &#34;&#34; then surveyNumber else &#34;SN-4509/A&#34;)" target="url" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="elementTemplateVersion" value="11" />
          <zeebe:header key="resultExpression" value="={landRegistryValid: response.body.valid, landRegistryMessage: response.body.message, ownershipStatus: response.body.ownershipStatus}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocValid_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Gateway_LandValid</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Land Verification Check -->
    <bpmn:exclusiveGateway id="Gateway_LandVerification" name="Land / Survey Valid?">
      <bpmn:incoming>Flow_To_Gateway_LandValid</bpmn:incoming>
      <bpmn:outgoing>Flow_LandValid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_LandValid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_LandRejected" name="Rejected (Land / Survey Invalid)">
      <bpmn:incoming>Flow_LandValid_No</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway: Merge Review Entry (Initial submission or Blueprint Revision) -->
    <bpmn:exclusiveGateway id="Gateway_ReviewEntry" name="Merge Review Entry">
      <bpmn:incoming>Flow_LandValid_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_RevisionSubmitted</bpmn:incoming>
      <bpmn:outgoing>Flow_To_ParallelReviews</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Stage 3: PARALLEL MULTI-INSTANCE DEPARTMENT REVIEWS (Direct Frontend Approval) -->
    <bpmn:receiveTask id="Task_ParallelDepartmentReview" name="Statutory Department Reviews (Admin Clearance)" messageRef="Message_DepartmentApproval">
      <bpmn:documentation>Parallel Multi-Instance Activity (|||): Spawns 4 parallel review instances for Fire Safety, Water Works, Zoning, and Environmental Board. Each instance is approved directly in the CivicFlow web frontend by the Municipal Admin without using Tasklist.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="= string(applicationId) + &#34;_&#34; + department" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_ParallelReviews</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EvaluateDecision</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="= [&#34;FIRE_SAFETY&#34;, &#34;WATER&#34;, &#34;ZONING&#34;, &#34;ENVIRONMENTAL&#34;]" inputElement="department" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:receiveTask>

    <!-- Stage 4: DMN Business Rule Task -->
    <bpmn:businessRuleTask id="Task_EvaluateReviews" name="Evaluate Department Decisions (DMN)">
      <bpmn:documentation>DMN Decision Table (decision-review-evaluation): Evaluates Fire, Water, Zoning, and Environmental decisions with Hit Policy FIRST.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="decision-review-evaluation" resultVariable="decisionResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=decisionResult.reviewDecision" target="reviewDecision" />
          <zeebe:output source="=decisionResult.evaluationSummary" target="evaluationSummary" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_EvaluateDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Gateway_OverallDecision</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- Gateway: Overall Department Review Decision -->
    <bpmn:exclusiveGateway id="Gateway_OverallDecision" name="Overall Decision?">
      <bpmn:incoming>Flow_To_Gateway_OverallDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Revision</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_DeptRejected" name="Application Rejected">
      <bpmn:incoming>Flow_Decision_Rejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Receive Task: Blueprint Revision Upload from Frontend -->
    <bpmn:receiveTask id="Task_ApplicantRevision" name="Applicant Uploads Revised Blueprint" messageRef="Message_BlueprintRevised">
      <bpmn:documentation>Applicant updates architectural drawings directly in CivicFlow portal to resolve department remarks.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="= string(applicationId)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_Revision</bpmn:incoming>
      <bpmn:outgoing>Flow_RevisionSubmitted</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Stage 5: Fee Calculation Call Activity -->
    <bpmn:callActivity id="CallActivity_FeeCalculation" name="Calculate Municipal Permit Fee">
      <bpmn:documentation>Invokes sub-process executing DMN permit fee matrix based on building specifications.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_MunicipalFeeCalculation" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Decision_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_To_PaymentTask</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- Stage 6: Citizen Payment (Frontend Web Portal) -->
    <bpmn:receiveTask id="Task_CitizenPayment" name="Citizen / Architect Payment" messageRef="Message_CitizenPayment">
      <bpmn:documentation>Citizen completes permit fee payment via Credit Card / Net Banking directly in CivicFlow Web Portal.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="= string(applicationId)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_PaymentTask</bpmn:incoming>
      <bpmn:incoming>Flow_Payment_Failed</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Gateway_Payment</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Gateway: Payment Verification -->
    <bpmn:exclusiveGateway id="Gateway_PaymentStatus" name="Payment Success?">
      <bpmn:incoming>Flow_To_Gateway_Payment</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Payment_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Stage 7: Generate Official Digital Permit & PDF -->
    <bpmn:serviceTask id="Task_GeneratePermit" name="Generate Digital Permit &amp; PDF">
      <bpmn:documentation>Generates digitally signed PDF certificate with cryptographic SHA-256 seal.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="permit-generation-worker" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Payment_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_To_EndSuccess</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PermitIssued" name="Permit Issued &amp; Workflow Complete">
      <bpmn:incoming>Flow_To_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ========================================== -->
    <!-- SEQUENCE FLOWS                             -->
    <!-- ========================================== -->
    <bpmn:sequenceFlow id="Flow_To_DocVerification" sourceRef="StartEvent_ApplicationSubmitted" targetRef="Task_DocumentVerification" />
    <bpmn:sequenceFlow id="Flow_To_Gateway_DocValid" sourceRef="Task_DocumentVerification" targetRef="Gateway_DocVerification" />
    <bpmn:sequenceFlow id="Flow_DocValid_Yes" name="Valid" sourceRef="Gateway_DocVerification" targetRef="Task_LandRegistryVerification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DocValid_No" name="Missing / Invalid" sourceRef="Gateway_DocVerification" targetRef="Task_CorrectMissingDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_From_DocCorrection" sourceRef="Task_CorrectMissingDocuments" targetRef="Task_DocumentVerification" />
    <bpmn:sequenceFlow id="Flow_To_Gateway_LandValid" sourceRef="Task_LandRegistryVerification" targetRef="Gateway_LandVerification" />
    <bpmn:sequenceFlow id="Flow_LandValid_Yes" name="Valid Title" sourceRef="Gateway_LandVerification" targetRef="Gateway_ReviewEntry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= landRegistryValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LandValid_No" name="Disputed" sourceRef="Gateway_LandVerification" targetRef="EndEvent_LandRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= landRegistryValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_ParallelReviews" sourceRef="Gateway_ReviewEntry" targetRef="Task_ParallelDepartmentReview" />
    <bpmn:sequenceFlow id="Flow_To_EvaluateDecision" sourceRef="Task_ParallelDepartmentReview" targetRef="Task_EvaluateReviews" />
    <bpmn:sequenceFlow id="Flow_To_Gateway_OverallDecision" sourceRef="Task_EvaluateReviews" targetRef="Gateway_OverallDecision" />
    <bpmn:sequenceFlow id="Flow_Decision_Approved" name="All Approved" sourceRef="Gateway_OverallDecision" targetRef="CallActivity_FeeCalculation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Revision" name="Revision" sourceRef="Gateway_OverallDecision" targetRef="Task_ApplicantRevision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "REVISION_REQUESTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decision_Rejected" name="Rejected" sourceRef="Gateway_OverallDecision" targetRef="EndEvent_DeptRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewDecision = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RevisionSubmitted" sourceRef="Task_ApplicantRevision" targetRef="Gateway_ReviewEntry" />
    <bpmn:sequenceFlow id="Flow_To_PaymentTask" sourceRef="CallActivity_FeeCalculation" targetRef="Task_CitizenPayment" />
    <bpmn:sequenceFlow id="Flow_To_Gateway_Payment" sourceRef="Task_CitizenPayment" targetRef="Gateway_PaymentStatus" />
    <bpmn:sequenceFlow id="Flow_Payment_Success" name="Paid" sourceRef="Gateway_PaymentStatus" targetRef="Task_GeneratePermit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentSuccess = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Payment_Failed" name="Failed" sourceRef="Gateway_PaymentStatus" targetRef="Task_CitizenPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentSuccess = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_To_EndSuccess" sourceRef="Task_GeneratePermit" targetRef="EndEvent_PermitIssued" />

  </bpmn:process>

  <!-- ========================================== -->
  <!-- BPMN DIAGRAM VISUAL LAYOUT                 -->
  <!-- ========================================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_MunicipalPermit">
    <bpmndi:BPMNPlane id="BPMNPlane_MunicipalPermit" bpmnElement="Process_MunicipalBuildingPermit">

      <!-- Start Event -->
      <bpmndi:BPMNShape id="Shape_StartEvent" bpmnElement="StartEvent_ApplicationSubmitted">
        <dc:Bounds x="160" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="151" y="305" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task: Document Verification -->
      <bpmndi:BPMNShape id="Shape_Task_DocVerification" bpmnElement="Task_DocumentVerification">
        <dc:Bounds x="250" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Doc Valid -->
      <bpmndi:BPMNShape id="Shape_Gateway_DocVerification" bpmnElement="Gateway_DocVerification" isMarkerVisible="true">
        <dc:Bounds x="420" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="403" y="312" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task: Correct Missing Documents -->
      <bpmndi:BPMNShape id="Shape_Task_CorrectDocs" bpmnElement="Task_CorrectMissingDocuments">
        <dc:Bounds x="385" y="100" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Land Registry REST API -->
      <bpmndi:BPMNShape id="Shape_Task_LandRegistry" bpmnElement="Task_LandRegistryVerification">
        <dc:Bounds x="520" y="240" width="130" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Land Valid -->
      <bpmndi:BPMNShape id="Shape_Gateway_LandVerification" bpmnElement="Gateway_LandVerification" isMarkerVisible="true">
        <dc:Bounds x="700" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="692" y="312" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- End Event: Land Rejected -->
      <bpmndi:BPMNShape id="Shape_End_LandRejected" bpmnElement="EndEvent_LandRejected">
        <dc:Bounds x="707" y="390" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="433" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Gateway: Review Entry Merge -->
      <bpmndi:BPMNShape id="Shape_Gateway_ReviewEntry" bpmnElement="Gateway_ReviewEntry" isMarkerVisible="true">
        <dc:Bounds x="800" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="790" y="312" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- PARALLEL MULTI-INSTANCE ACTIVITY: Department Reviews -->
      <bpmndi:BPMNShape id="Shape_Task_ParallelDepartmentReview" bpmnElement="Task_ParallelDepartmentReview">
        <dc:Bounds x="900" y="240" width="150" height="80" />
      </bpmndi:BPMNShape>

      <!-- DMN Business Rule Task -->
      <bpmndi:BPMNShape id="Shape_Task_EvaluateReviews" bpmnElement="Task_EvaluateReviews">
        <dc:Bounds x="1100" y="240" width="130" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Overall Decision -->
      <bpmndi:BPMNShape id="Shape_Gateway_OverallDecision" bpmnElement="Gateway_OverallDecision" isMarkerVisible="true">
        <dc:Bounds x="1280" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1262" y="312" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- End Event: Dept Rejected -->
      <bpmndi:BPMNShape id="Shape_End_DeptRejected" bpmnElement="EndEvent_DeptRejected">
        <dc:Bounds x="1287" y="390" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1279" y="433" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task: Applicant Uploads Revised Blueprint -->
      <bpmndi:BPMNShape id="Shape_Task_ApplicantRevision" bpmnElement="Task_ApplicantRevision">
        <dc:Bounds x="1100" y="100" width="130" height="80" />
      </bpmndi:BPMNShape>

      <!-- Call Activity: Fee Calculation -->
      <bpmndi:BPMNShape id="Shape_CallActivity_Fee" bpmnElement="CallActivity_FeeCalculation" isExpanded="false">
        <dc:Bounds x="1380" y="240" width="130" height="80" />
      </bpmndi:BPMNShape>

      <!-- Task: Citizen Payment -->
      <bpmndi:BPMNShape id="Shape_Task_CitizenPayment" bpmnElement="Task_CitizenPayment">
        <dc:Bounds x="1560" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway: Payment Status -->
      <bpmndi:BPMNShape id="Shape_Gateway_Payment" bpmnElement="Gateway_PaymentStatus" isMarkerVisible="true">
        <dc:Bounds x="1730" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1730" y="312" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task: Generate Digital Permit & PDF -->
      <bpmndi:BPMNShape id="Shape_Task_GeneratePermit" bpmnElement="Task_GeneratePermit">
        <dc:Bounds x="1830" y="240" width="130" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event: Permit Issued -->
      <bpmndi:BPMNShape id="Shape_End_PermitIssued" bpmnElement="EndEvent_PermitIssued">
        <dc:Bounds x="2012" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1995" y="305" width="70" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ========================================== -->
      <!-- EDGES / SEQUENCE FLOW VISUAL LAYOUT        -->
      <!-- ========================================== -->
      <bpmndi:BPMNEdge id="Edge_Flow_To_DocVerification" bpmnElement="Flow_To_DocVerification">
        <di:waypoint x="196" y="280" />
        <di:waypoint x="250" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_To_Gateway_DocValid" bpmnElement="Flow_To_Gateway_DocValid">
        <di:waypoint x="370" y="280" />
        <di:waypoint x="420" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_DocValid_Yes" bpmnElement="Flow_DocValid_Yes">
        <di:waypoint x="470" y="280" />
        <di:waypoint x="520" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="484" y="262" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_DocValid_No" bpmnElement="Flow_DocValid_No">
        <di:waypoint x="445" y="255" />
        <di:waypoint x="445" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="451" y="215" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_From_DocCorrection" bpmnElement="Flow_From_DocCorrection">
        <di:waypoint x="385" y="140" />
        <di:waypoint x="310" y="140" />
        <di:waypoint x="310" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_To_Gateway_LandValid" bpmnElement="Flow_To_Gateway_LandValid">
        <di:waypoint x="650" y="280" />
        <di:waypoint x="700" y="280" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Flow_LandValid_Yes" bpmnElement="Flow_LandValid_Yes">
        <di:waypoint x="750" y="280" />
        <di:waypoint x="800" y="280" />
        <bpmndi:BPMNLabel>

{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.49.0"
  },
  "schemaVersion": 18,
  "id": "form-water-review",
  "type": "default",
  "components": [
    {
      "id": "Text_Title",
      "type": "text",
      "text": "# Water Supply & Sewerage Board\n### Hydraulic Feasibility & Drainage Scrutiny\nInspect potable water demand, trunk pipe pressure, and sewage connection capacity."
    },
    {
      "id": "Field_AppNumber",
      "key": "applicationNumber",
      "label": "Application Reference Number",
      "type": "textfield",
      "readonly": true,
      "layout": { "row": "Row_1", "columns": 6 }
    },
    {
      "id": "Field_ApplicantName",
      "key": "applicantName",
      "label": "Applicant Name",
      "type": "textfield",
      "readonly": true,
      "layout": { "row": "Row_1", "columns": 6 }
    },
    {
      "id": "Field_BuildingType",
      "key": "buildingType",
      "label": "Building Category",
      "type": "textfield",
      "readonly": true,
      "layout": { "row": "Row_2", "columns": 4 }
    },
    {
      "id": "Field_BuiltUpArea",
      "key": "proposedBuiltUpArea",
      "label": "Proposed Built-Up Area (sq.ft.)",
      "type": "number",
      "readonly": true,
      "layout": { "row": "Row_2", "columns": 4 }
    },
    {
      "id": "Field_Floors",
      "key": "floors",
      "label": "Floors",
      "type": "number",
      "readonly": true,
      "layout": { "row": "Row_2", "columns": 4 }
    },
    {
      "id": "Text_Checklist",
      "type": "text",
      "text": "#### Water & Sanitation Technical Checklist:"
    },
    {
      "id": "Field_Check_Supply",
      "key": "waterConnectionFeasible",
      "label": "Connection to main municipal water distribution line is hydraulically viable",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "id": "Field_Check_Sewerage",
      "key": "sewerageCapacityVerified",
      "label": "Municipal sewer trunk line capacity or dedicated on-site STP confirmed",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "id": "Field_Check_Rwh",
      "key": "rwhProvisionCompliant",
      "label": "Rainwater harvesting recharge pit design complies with municipal mandate",
      "type": "checkbox",
      "defaultValue": true
    },
    {
      "id": "Field_Decision",
      "key": "waterReviewDecision",
      "label": "Water Department Official Clearance Decision",
      "type": "radio",
      "validate": { "required": true },
      "defaultValue": "APPROVED",
      "values": [
        { "label": "Approve (Issue Water & Sanitation Clearance)", "value": "APPROVED" },
        { "label": "Request Revision (Requires Modified Plumbing/STP Scheme)", "value": "REVISION_REQUESTED" },
        { "label": "Reject (Inadequate Water Grid Capacity)", "value": "REJECTED" }
      ]
    },
    {
      "id": "Field_Comments",
      "key": "waterComments",
      "label": "Water Board Engineer Assessment Notes",
      "type": "textarea",
      "validate": { "required": true, "maxLength": 1000 },
      "defaultValue": "Adequate supply pressure verified from feeder line. On-site recharge well sizing verified."
    }
  ]
}
